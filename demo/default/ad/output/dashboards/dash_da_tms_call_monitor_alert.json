            "pivotTopNEnabled": false,
            "pivotTopN": 20,
            "pivotTopNOthers": true
          }
        },
        "settings": {
          "monitoringAlertRenderEnabled": true,
          "anomalyFocusMode": true,
          "dimensionDisplayNames": {
            "DIM_sales_expert": "销售专家"
          },
          "visibleMeasureCodes": [
            "MEAS_phone_call_count",
            "MEAS_avg_call_quality_score",
            "MEAS_avg_slot_coverage_rate",
            "MEAS_low_quality_call_count",
            "MEAS_low_coverage_call_count",
            "MEAS_missing_slot_count"
