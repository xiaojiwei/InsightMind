  "widgets": [
    {
      "id": "w_call_monitor_expert",
      "adhocId": "da_tms_call_monitor_expert_pivot",
      "name": "销售专家质量风险透视",
      "spec": {
        "id": "da_tms_call_monitor_expert_pivot",
        "name": "监控预警｜销售专家质量风险透视",
        "description": "按销售专家汇总通话量、平均质量分、关键信息覆盖率、低质量、低覆盖和缺失槽位；低分、低覆盖、问题集中及样本不足会直接在单元格上预警，并可点击下钻到通话明细。",
        "query": {
          "measures": [
            "ad.phone_call_count",
            "ad.avg_call_quality_score",
            "ad.avg_slot_coverage_rate",
            "ad.low_quality_call_count",
            "ad.low_coverage_call_count",
            "ad.missing_slot_count"
          ],
          "dimensions": [
            "ad.sales_expert"
          ],
          "filters": [],
          "order": {
            "ad.low_quality_call_count": "desc",
            "ad.low_coverage_call_count": "desc",
            "ad.avg_call_quality_score": "asc"
          },
          "limit": 1000
        },
        "view": {
          "type": "pivot",
          "chartType": "auto",
          "encoding": {
            "pivotColumns": [],
            "pivotHeatmapEnabled": false,
            "pivotHeatmapLowColor": "#f7f9f6",
            "pivotHeatmapHighColor": "#c84b4b",
            "pivotRowSubtotal": false,
            "pivotColumnSubtotal": false,
            "pivotGrandTotal": false,
            "pivotCalcMode": "value",
