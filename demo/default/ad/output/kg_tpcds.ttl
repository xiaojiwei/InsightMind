db:belongsToSchema a owl:ObjectProperty ;
    rdfs:label "belongsToSchema" ;
    rdfs:domain db:Table ;
    rdfs:range db:Schema ;
    owl:inverseOf db:containsTable .

db:belongsToTable a owl:ObjectProperty ;
    rdfs:label "belongsToTable" ;
    rdfs:domain db:Column ;
    rdfs:range db:Table ;
    owl:inverseOf db:containsColumn .

db:containsColumn a owl:ObjectProperty ;
    rdfs:label "containsColumn" ;
    rdfs:domain db:Table ;
    rdfs:range db:Column ;
    owl:inverseOf db:belongsToTable .

db:containsTable a owl:ObjectProperty ;
    rdfs:label "containsTable" ;
    rdfs:domain db:Schema ;
    rdfs:range db:Table ;
    owl:inverseOf db:belongsToSchema .

