<http://kg.local/instance/db/mysql_local> a db:Database ;
    rdfs:label "mysql_local" ;
    db:containsSchema <http://kg.local/instance/schema/mysql_local/tpcds> ;
    db:database "tpcds" ;
    db:dbType "mysql" ;
    db:host "localhost" ;
    db:name "mysql_local" ;
    db:normalizedName "mysql_local" ;
    db:password "root" ;
    db:port 3306 ;
    db:username "root" .

