    ind:definition "衡量网络退货渠道产生的总净亏损金额" ;
    ind:enName "MEAS_web_net_loss" ;
    ind:hasMeasureApp inst:ma_web_net_loss_origin ;
    ind:measTypeCode 0 ;
    ind:unit "元" .

