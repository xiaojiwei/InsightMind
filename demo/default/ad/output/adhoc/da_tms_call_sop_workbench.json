{
  "id": "da_tms_call_sop_workbench",
  "name": "门店店长｜试驾邀约通话质检工作台",
  "description": "参考试驾邀约诊断页面的通话质检工作台结构，基于当前筛选范围下的通话明细、ASR 文本、SOP 小达成点和邀约结果，支持店长逐通复盘。",
  "query": {
    "measures": [
      "ad.quality_record_count"
    ],
    "dimensions": [
      "ad.sales_expert",
      "ad.quality_score_level",
      "ad.intent"
    ],
    "filters": [
      {
        "kind": "dimension",
        "member": "ad.date_day",
        "operator": "in",
        "values": [
          "2026-07-02"
        ]
      },
      {
        "kind": "dimension",
        "member": "ad.store",
        "operator": "equals",
        "values": [
          "特斯拉汽车杭州演示体验中心"
        ]
      }
    ],
    "order": {
      "ad.quality_record_count": "desc"
    },
    "limit": 1000
  },
  "view": {
    "type": "chart",
    "chartType": "executive_report",
    "encoding": {
      "reportTemplate": "call_sop_quality_workbench",
      "reportTitle": "试驾邀约通话质检工作台"
    }
  },
  "settings": {
    "monitoringAlertRenderEnabled": true,
    "anomalyFocusMode": true
  },
  "drill": {
    "mode": "path",
    "path": [
      "ad.sales_expert",
      "ad.quality_score_level",
      "ad.intent",
      "ad.date_day"
    ],
    "stack": []
  },
  "kind": "adhoc",
  "updatedAt": "2026-07-10 09:30:00"
}
