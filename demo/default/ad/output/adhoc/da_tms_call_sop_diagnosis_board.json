{
  "id": "da_tms_call_sop_diagnosis_board",
  "name": "门店店长｜试驾前通话SOP诊断看板",
  "description": "参考试驾邀约诊断页面结构，基于接通电话质检结果，面向店长展示总体通话质量、SOP环节达成分布、销售专家达成分布和接通电话质量问题。",
  "query": {
    "measures": [
      "ad.quality_record_count",
      "ad.phone_call_count",
      "ad.pass_call_count",
      "ad.avg_call_quality_score",
      "ad.avg_slot_coverage_rate",
      "ad.low_quality_call_count",
      "ad.low_coverage_call_count",
      "ad.missing_slot_count"
    ],
    "dimensions": [
      "ad.quality_rule",
      "ad.quality_score_level",
      "ad.sales_expert",
      "ad.quality_issue_category"
    ],
    "filters": [
      {
        "kind": "dimension",
        "member": "ad.date_day",
        "operator": "in",
        "values": [
          "2026-07-02"
        ]
      },
      {
        "kind": "dimension",
        "member": "ad.store",
        "operator": "equals",
        "values": [
          "小鹏汽车杭州演示体验中心"
        ]
      }
    ],
    "order": {
      "ad.quality_record_count": "desc"
    },
    "limit": 1000
  },
  "view": {
    "type": "chart",
    "chartType": "executive_report",
    "encoding": {
      "reportTemplate": "call_sop_diagnosis",
      "reportTitle": "试驾前通话质量诊断"
    }
  },
  "settings": {
    "monitoringAlertRenderEnabled": true,
    "anomalyFocusMode": true
  },
  "drill": {
    "mode": "path",
    "path": [
      "ad.quality_rule",
      "ad.sales_expert",
      "ad.quality_issue_category",
      "ad.intent",
      "ad.date_day"
    ],
    "stack": []
  },
  "kind": "adhoc",
  "updatedAt": "2026-07-09 16:40:00"
}
