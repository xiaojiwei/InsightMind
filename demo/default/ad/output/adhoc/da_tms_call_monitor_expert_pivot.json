{
  "id": "da_tms_call_monitor_expert_pivot",
  "name": "监控预警｜销售专家质量风险透视",
  "description": "按销售专家汇总通话量、平均质量分、关键信息覆盖率、低质量、低覆盖和缺失槽位；低分、低覆盖、问题集中及样本不足会直接在单元格上预警，并可点击下钻到通话明细。",
  "query": {
    "measures": [
      "ad.phone_call_count",
      "ad.avg_call_quality_score",
      "ad.avg_slot_coverage_rate",
      "ad.low_quality_call_count",
      "ad.low_coverage_call_count",
      "ad.missing_slot_count"
    ],
    "dimensions": [
      "ad.sales_expert"
    ],
    "filters": [
      {
        "kind": "dimension",
        "member": "ad.date_day",
        "operator": "in",
        "values": [
          "2026-07-02"
        ]
      },
      {
        "kind": "dimension",
        "member": "ad.store",
        "operator": "equals",
        "values": [
          "特斯拉汽车杭州演示体验中心"
        ]
      }
    ],
    "order": {
      "ad.low_quality_call_count": "desc",
      "ad.low_coverage_call_count": "desc",
      "ad.avg_call_quality_score": "asc"
    },
    "limit": 1000
  },
  "view": {
    "type": "pivot",
    "chartType": "auto",
    "encoding": {
      "pivotColumns": [],
      "pivotHeatmapEnabled": false,
      "pivotHeatmapLowColor": "#f7f9f6",
      "pivotHeatmapHighColor": "#c84b4b",
      "pivotRowSubtotal": false,
      "pivotColumnSubtotal": false,
      "pivotGrandTotal": false,
      "pivotCalcMode": "value",
      "pivotMovingWindow": 3,
      "pivotTopNEnabled": false,
      "pivotTopN": 20,
      "pivotTopNOthers": true
    }
  },
  "settings": {
    "monitoringAlertRenderEnabled": true,
    "anomalyFocusMode": true,
    "dimensionDisplayNames": {
      "DIM_sales_expert": "销售专家"
    },
    "visibleMeasureCodes": [
      "MEAS_phone_call_count",
      "MEAS_avg_call_quality_score",
      "MEAS_avg_slot_coverage_rate",
      "MEAS_low_quality_call_count",
      "MEAS_low_coverage_call_count",
      "MEAS_missing_slot_count"
    ],
    "measureDisplayNames": {
      "MEAS_phone_call_count": "通话样本数",
      "MEAS_avg_call_quality_score": "平均质量分",
      "MEAS_avg_slot_coverage_rate": "平均覆盖率",
      "MEAS_low_quality_call_count": "低质量通话",
      "MEAS_low_coverage_call_count": "低覆盖通话",
      "MEAS_missing_slot_count": "缺失检查点"
    }
  },
  "drill": {
    "mode": "path",
    "path": [
      "ad.quality_issue_category",
      "ad.quality_rule",
      "ad.intent",
      "ad.date_day"
    ],
    "stack": []
  },
  "kind": "adhoc",
  "updatedAt": "2026-07-15 10:30:00"
}
