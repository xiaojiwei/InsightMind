DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL_NAME=deepseek-chat
DEEPSEEK_API_KEY=sk-your-deepseek-api-key

# Usage feedback MVP: MySQL record/query only; it never updates KG files.
FEEDBACK_ENABLED=true
# Defaults to the first MySQL datasource in config.local.yaml/config.yaml.
# FEEDBACK_DB_HOST=127.0.0.1
# FEEDBACK_DB_PORT=3306
# FEEDBACK_DB_USER=root
# FEEDBACK_DB_PASSWORD=your-password
# FEEDBACK_DB_NAME=tpcds
# FEEDBACK_DB_CHARSET=utf8mb4

# Forecast, Pace to Goal, and cross-metric insight persistence.
# Defaults to insights.mysql, feedback.mysql, or the first configured MySQL datasource.
# INSIGHTS_DB_HOST=127.0.0.1
# INSIGHTS_DB_PORT=3306
# INSIGHTS_DB_USER=root
# INSIGHTS_DB_PASSWORD=your-password
# INSIGHTS_DB_NAME=tpcds
# INSIGHTS_DB_CHARSET=utf8mb4
# DA base URL used to resolve governed goals by id.
# INSIGHTMIND_DA_BASE_URL=http://127.0.0.1:8091

# Shared semantic dictionary / vector recall for NLQ and Insight analysis.
INSIGHTMIND_SEMANTIC_VECTOR_ENABLED=true
# Safe no-download default. Use sentence_transformer only when optional
# analysis dependencies and the configured model are available locally.
INSIGHTMIND_SEMANTIC_EMBEDDING_PROVIDER=hashing
# INSIGHTMIND_SEMANTIC_EMBEDDING_MODEL=paraphrase-multilingual-MiniLM-L12-v2
# INSIGHTMIND_SEMANTIC_FUZZY_THRESHOLD=0.72
# INSIGHTMIND_SEMANTIC_VECTOR_THRESHOLD=0.15
# INSIGHTMIND_SEMANTIC_MAX_VALUES_PER_DIMENSION=200
# INSIGHTMIND_SEMANTIC_MAX_DIMENSION_CARDINALITY=500
# INSIGHTMIND_SEMANTIC_DICTIONARY=/absolute/path/to/semantic_dictionary.yaml
# Optional explicit source KG binding. New BKG builds persist a hash-checked
# sidecar automatically; use this only for legacy deployments.
# INSIGHTMIND_SEMANTIC_SOURCE_TTL=/absolute/path/to/source-kg.ttl
# Required for catalog/search/map HTTP APIs and the MCP proxy. Generate a long
# random secret and send it as X-InsightMind-Semantic-Token.
# INSIGHTMIND_SEMANTIC_API_TOKEN=replace-with-a-random-secret
# Reviewed MySQL dictionary entries are opt-in; PENDING entries are never loaded.
INSIGHTMIND_SEMANTIC_FEEDBACK_ENABLED=false
# INSIGHTMIND_SEMANTIC_FEEDBACK_REFRESH_SECONDS=30
# Feedback management endpoints do not use a separate Token. Protect the AD
# service with a gateway/RBAC layer before exposing it to multiple users.
# INSIGHTMIND_FEEDBACK_ACTOR=semantic-governance-service
