inst:meas_staffed_department_manager_rate a ind:Measure ;
    ind:belongsToCategory inst:cat_hr_leadership ;
    ind:caliber "有员且有负责人部门数 / 有员部门数。" ;
    ind:cnName "有员部门负责人配置率" ;
    ind:code "MEAS_staffed_department_manager_rate" ;
