    ind:enName "MEAS_salary_in_range_headcount" ;
    ind:hasMeasureApp inst:ma_salary_in_range_headcount_origin ;
    ind:measTypeCode 0 ;
    ind:measurementCadence "月度；组织调整或薪酬周期后复核" ;
    ind:metricRole "driver" ;
    ind:northStar 0 ;
    ind:online 1 ;
    ind:standardReference "ISO 30414:2025 costs" ;
    ind:unit "人" .

inst:meas_single_person_department_count a ind:Measure ;
    ind:belongsToCategory inst:cat_hr_leadership ;
    ind:caliber "SUM(single_person_department_flag)。" ;
    ind:cnName "单人部门数" ;
    ind:code "MEAS_single_person_department_count" ;
    ind:definition "当前仅一名员工的部门数。" ;
    ind:enName "MEAS_single_person_department_count" ;
    ind:hasMeasureApp inst:ma_single_person_department_count_origin ;
    ind:measTypeCode 0 ;
    ind:measurementCadence "月度；组织调整或薪酬周期后复核" ;
