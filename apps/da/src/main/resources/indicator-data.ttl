    ind:cnName "有员部门数" ;
    ind:code "MEAS_staffed_department_count" ;
    ind:definition "至少配置一名员工的部门数。" ;
    ind:enName "MEAS_staffed_department_count" ;
    ind:hasMeasureApp inst:ma_staffed_department_count_origin ;
    ind:measTypeCode 0 ;
    ind:measurementCadence "月度；组织调整或薪酬周期后复核" ;
    ind:metricRole "driver" ;
    ind:northStar 0 ;
    ind:online 1 ;
    ind:standardReference "ISO 30414:2025 workforce composition" ;
