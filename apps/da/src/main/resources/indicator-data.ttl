    ind:hasMeasureApp inst:ma_salary_below_range_headcount_origin ;
    ind:measTypeCode 0 ;
    ind:measurementCadence "月度；组织调整或薪酬周期后复核" ;
    ind:metricRole "guardrail" ;
    ind:northStar 0 ;
    ind:online 1 ;
    ind:standardReference "ISO 30414:2025 costs" ;
    ind:targetGuidance "目标为0；例外需有审批与整改计划。" ;
