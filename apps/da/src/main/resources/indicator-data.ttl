    ind:enName "MEAS_staffed_department_manager_rate" ;
    ind:hasMeasureApp inst:ma_staffed_department_manager_rate_origin ;
    ind:measTypeCode 1 ;
    ind:measurementCadence "月度；组织调整或薪酬周期后复核" ;
