inst:meas_salary_in_range_headcount a ind:Measure ;
    ind:belongsToCategory inst:cat_hr_cost ;
    ind:caliber "SUM(salary_in_range_flag)。" ;
    ind:cnName "薪酬带内人数" ;
    ind:code "MEAS_salary_in_range_headcount" ;
