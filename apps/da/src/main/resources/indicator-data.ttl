    ind:definition "基本薪酬高于岗位最高薪酬的人数。" ;
    ind:enName "MEAS_salary_above_range_headcount" ;
    ind:hasMeasureApp inst:ma_salary_above_range_headcount_origin ;
    ind:measTypeCode 0 ;
    ind:measurementCadence "月度；组织调整或薪酬周期后复核" ;
    ind:metricRole "guardrail" ;
    ind:northStar 0 ;
    ind:online 1 ;
    ind:standardReference "ISO 30414:2025 costs" ;
    ind:targetGuidance "目标为0；例外需有审批与岗位评估。" ;
    ind:unit "人" .

inst:meas_salary_band_compliance_rate a ind:Measure ;
    ind:belongsToCategory inst:cat_hr_cost ;
