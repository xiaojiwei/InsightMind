inst:meas_total_direct_reports a ind:Measure ;
    ind:belongsToCategory inst:cat_hr_leadership ;
    ind:caliber "SUM(direct_report_count)。" ;
    ind:cnName "直属下属总数" ;
    ind:code "MEAS_total_direct_reports" ;
    ind:definition "所有管理者的直属下属数之和。" ;
    ind:enName "MEAS_total_direct_reports" ;
    ind:hasMeasureApp inst:ma_total_direct_reports_origin ;
    ind:measTypeCode 0 ;
