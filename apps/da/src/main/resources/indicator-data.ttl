inst:meas_staffed_managed_department_count a ind:Measure ;
    ind:belongsToCategory inst:cat_hr_leadership ;
    ind:caliber "SUM(staffed_with_manager_flag)。" ;
    ind:cnName "有员且有负责人部门数" ;
    ind:code "MEAS_staffed_managed_department_count" ;
    ind:definition "有员工且已配置部门负责人的部门数。" ;
    ind:enName "MEAS_staffed_managed_department_count" ;
    ind:hasMeasureApp inst:ma_staffed_managed_department_count_origin ;
    ind:measTypeCode 0 ;
    ind:measurementCadence "月度；组织调整或薪酬周期后复核" ;
