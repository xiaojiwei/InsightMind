inst:meas_celn_stage_user_count a ind:Measure ;
    ind:code "MEAS_celn_stage_user_count" ;
    ind:cnName "CELN阶段用户数" ;
    ind:enName "MEAS_celn_stage_user_count" ;
    ind:definition "门店当前 C/E/L/N 四类用户分布数量" ;
    ind:caliber "仅统计 CELN阶段推进 分组；聚合口径：SUM(funnel_count)，来源：im_celn_store_funnel_fact" ;
    ind:unit "人" ;
    ind:measTypeCode 0 ;
    ind:viewTypeCode 0 ;
    ind:belongsToCategory inst:cat_celn_user_operation ;
    ind:hasMeasureApp inst:ma_meas_celn_stage_user_count__im_celn_store_funnel_fact .

inst:ma_meas_celn_stage_user_count__im_celn_store_funnel_fact a ind:MeasureApp ;
    ind:applyTypeCode 0 ;
    ind:expression "[{\"operator\": \"sum\", \"operatingType\": \"operator\"}]" ;
    ind:factColumn "funnel_count" ;
    ind:whereCondition "celn_funnel_group = 'CELN阶段推进'" ;
    ind:hasColumnDT false ;
    ind:available 1 ;
    ind:appliesToTable inst:tbl_da_tms__im_celn_store_funnel_fact .

inst:meas_celn_ln_user_count a ind:Measure ;
    ind:code "MEAS_celn_ln_user_count" ;
    ind:cnName "L/N用户数" ;
    ind:enName "MEAS_celn_ln_user_count" ;
    ind:definition "门店当前 L 与 N 阶段用户数量，作为每日主动预警的核心观察指标" ;
    ind:caliber "仅统计 CELN阶段推进 分组中 L 品牌意向 与 N Why Now 节点；聚合口径：SUM(funnel_count)，来源：im_celn_store_funnel_fact" ;
    ind:unit "人" ;
    ind:measTypeCode 0 ;
    ind:viewTypeCode 0 ;
    ind:belongsToCategory inst:cat_celn_user_operation ;
    ind:hasMeasureApp inst:ma_meas_celn_ln_user_count__im_celn_store_funnel_fact .

inst:ma_meas_celn_ln_user_count__im_celn_store_funnel_fact a ind:MeasureApp ;
    ind:applyTypeCode 0 ;
    ind:expression "[{\"operator\": \"sum\", \"operatingType\": \"operator\"}]" ;
    ind:factColumn "funnel_count" ;
    ind:whereCondition "celn_funnel_group = 'CELN阶段推进' AND celn_funnel_stage_code IN ('03_L', '04_N')" ;
    ind:hasColumnDT false ;
    ind:available 1 ;
    ind:appliesToTable inst:tbl_da_tms__im_celn_store_funnel_fact .

