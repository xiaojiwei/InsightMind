inst:meas_average_assignment_duration_years a ind:Measure ;
    ind:belongsToCategory inst:cat_hr_mobility ;
    ind:caliber "AVG(assignment_duration_years)。" ;
    ind:cnName "平均历史任职时长" ;
    ind:code "MEAS_average_assignment_duration_years" ;
    ind:definition "历史任职区间的平均持续年数。" ;
    ind:enName "MEAS_average_assignment_duration_years" ;
    ind:hasMeasureApp inst:ma_average_assignment_duration_years_origin ;
    ind:measTypeCode 0 ;
    ind:measurementCadence "月度；组织调整或薪酬周期后复核" ;
    ind:metricRole "driver" ;
    ind:northStar 0 ;
    ind:online 1 ;
    ind:standardReference "ISO 30414:2025 mobility and succession planning" ;
    ind:unit "年" .

inst:meas_average_base_salary a ind:Measure ;
    ind:belongsToCategory inst:cat_hr_cost ;
    ind:caliber "AVG(salary)。" ;
    ind:cnName "平均基本薪酬" ;
    ind:code "MEAS_average_base_salary" ;
    ind:definition "当前在册人员的平均基本薪酬。" ;
    ind:enName "MEAS_average_base_salary" ;
    ind:hasMeasureApp inst:ma_average_base_salary_origin ;
    ind:measTypeCode 0 ;
    ind:measurementCadence "月度；组织调整或薪酬周期后复核" ;
    ind:metricRole "driver" ;
    ind:northStar 0 ;
    ind:online 1 ;
    ind:standardReference "ISO 30414:2025 costs" ;
    ind:unit "薪酬单位/月" .

inst:meas_average_compa_ratio a ind:Measure ;
    ind:belongsToCategory inst:cat_hr_cost ;
    ind:caliber "AVG(salary / salary_midpoint)。" ;
    ind:cnName "平均薪酬中位比" ;
    ind:code "MEAS_average_compa_ratio" ;
    ind:definition "员工薪酬相对岗位薪酬带中点的平均比值。" ;
    ind:enName "MEAS_average_compa_ratio" ;
    ind:hasMeasureApp inst:ma_average_compa_ratio_origin ;
    ind:measTypeCode 0 ;
    ind:measurementCadence "月度；组织调整或薪酬周期后复核" ;
    ind:metricRole "driver" ;
    ind:northStar 0 ;
    ind:online 1 ;
    ind:standardReference "ISO 30414:2025 costs" ;
    ind:targetGuidance "按岗位族、职级和绩效分层解释，不使用单一全员硬目标。" ;
    ind:unit "比值" .

inst:meas_average_department_size a ind:Measure ;
    ind:belongsToCategory inst:cat_hr_leadership ;
    ind:caliber "AVG(headcount)。" ;
    ind:cnName "平均部门规模" ;
    ind:code "MEAS_average_department_size" ;
